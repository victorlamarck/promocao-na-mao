---
// Uma página por rede, com todas as ofertas vigentes agrupadas pela seção do encarte.
// Boa para o Google: "ofertas Coelho Diniz Governador Valadares".
import Base from '../../layouts/Base.astro';
import CardOferta from '../../components/CardOferta.tsx';
import Anuncio from '../../components/Anuncio.astro';
import { dados } from '../../lib/dados';
import { diaMes, mercado, valeAte } from '../../lib/formato';

export async function getStaticPaths() {
  const { redes } = await dados();
  return redes.map((r) => ({ params: { slug: r.slug }, props: { rede: r } }));
}

const { rede } = Astro.props;
const { ofertas, anuncios } = await dados();
const daRede = ofertas.filter((o) => o.rede_id === rede.id);
const secoes = [...Map.groupBy(daRede, (o) => o.secao ?? 'Outras ofertas')];
const m = mercado(rede.slug);
const banner = anuncios.find((a) => a.formato === 'banner' && (a.rede_id == null || a.rede_id === rede.id));
const visiveis = 8; // por seção; o resto abre em "Ver todas" (continua no HTML, para o Google)
---
<Base titulo={`Ofertas ${rede.nome}`} descricao={`${rede.ofertas} ofertas do ${rede.nome} em Governador Valadares, válidas até ${diaMes(rede.ate)}.`} comLista>
  <section class="secao">
    <a href="/" class="suave">← Todos os mercados</a>
    <div style="display: flex; align-items: center; gap: 12px">
      <span class="avatar" style={`background: ${m.cor}`}>{m.logo ? <img src={m.logo} alt="" /> : m.sigla}</span>
      <div>
        <h1 style="font-size: 32px; line-height: 38px">Ofertas {rede.nome}</h1>
        <span class="suave">{rede.ofertas} ofertas · {rede.lojas} {rede.lojas === 1 ? 'loja' : 'lojas'} em GV · {valeAte(rede.ate)}</span>
      </div>
    </div>
    {m.clube && <p class="tracejado" style="margin: 0">O preço com <strong>{m.clube}</strong> vale para quem tem o cadastro do {rede.nome}.</p>}
  </section>

  {secoes.length > 1 && (
    <nav aria-label="Seções do encarte" class="atalhos fixos">
      {secoes.map(([s], i) => <a class="botao" style="flex: none" href={`#s${i}`}>{s}</a>)}
    </nav>
  )}

  {secoes.map(([secao, lista], i) => (
    <section class="secao" id={`s${i}`}>
      <h2>{secao}</h2>
      <div class="grade-ofertas">
        {lista.slice(0, visiveis).map((o) => <CardOferta o={o} mostrarMercado={false} />)}
      </div>
      {lista.length > visiveis && (
        <details class="mais">
          <summary class="botao">Ver todas as {lista.length}</summary>
          <div class="grade-ofertas">
            {lista.slice(visiveis).map((o) => <CardOferta o={o} mostrarMercado={false} />)}
          </div>
        </details>
      )}
    </section>
  ))}
  <Anuncio anuncio={banner} faixa />
</Base>

<style>
  /* as seções ficam no topo ao rolar; o título da seção não some embaixo delas */
  .fixos { position: sticky; top: 0; z-index: 5; margin: -8px 0; padding: 8px 0; background: var(--fundo); }
  .secao[id] { scroll-margin-top: 64px; }
  .mais summary { list-style: none; }
  .mais summary::-webkit-details-marker { display: none; }
  .mais[open] summary { display: none; } /* aberto, as ofertas continuam a grade de cima */
</style>
