---
// Anúncio vendido pelo dev (tabela anuncio) ou, sem anúncio, o convite "Anuncie aqui".
// Regras (docs/design.md): sempre com selo ("Patrocinado" no vendido, como no app), nunca cobre preço/validade,
// máx. 1 a cada 8 ofertas. Imagem quadrada; título em até 2 linhas e texto em até 3 (Guia do Anunciante).
import type { Anuncio } from '../lib/dados';
import { contatoAnuncie } from '../lib/config';
import { diaMes } from '../lib/formato';

interface Props { anuncio?: Anuncio; faixa?: boolean }
const { anuncio, faixa = false } = Astro.props;
---
{anuncio ? (
  <a class:list={['anuncio', { 'anuncio-faixa': faixa }]} href={anuncio.link_url ?? undefined} rel="sponsored noopener" target="_blank">
    <span class="selo">Patrocinado</span>
    {anuncio.imagem_url && <img src={anuncio.imagem_url} alt="" loading="lazy">}
    <strong class="anuncio-linhas" style="--linhas: 2">{anuncio.titulo}</strong>
    {anuncio.texto && <span class="suave anuncio-linhas" style="--linhas: 3">{anuncio.texto}</span>}
    {(anuncio.cupom_codigo || anuncio.cupom_regra) && (
      <span class="cupom">
        {anuncio.cupom_codigo && <strong>Cupom {anuncio.cupom_codigo}</strong>}
        <span>{[anuncio.cupom_regra, `até ${diaMes(anuncio.fim)}`].filter(Boolean).join(' · ')}</span>
      </span>
    )}
  </a>
) : (
  <a class:list={['anuncio', { 'anuncio-faixa': faixa }]} href={contatoAnuncie} rel="noopener" target={contatoAnuncie.startsWith('http') ? '_blank' : undefined}>
    <span class="selo">Anúncio</span>
    <span class="suave" style="flex: 1 1 240px">Seu comércio aqui, para quem está montando a lista de compras em GV.</span>
    <strong class="verde">Anuncie aqui</strong>
  </a>
)}

<style>
  /* cupom do comércio local (como no app): código, regra e validade */
  .cupom { display: flex; flex-direction: column; gap: 2px; padding: 8px 12px; border-radius: 10px; border: 1px dashed var(--verde); background: var(--verde-claro); color: var(--verde-escuro); font-size: 14px; user-select: text; }
</style>
